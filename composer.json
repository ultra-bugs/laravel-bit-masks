{
  "name"              : "zuko/laravel-bit-masks",
  "description"       : "Bitmask toolkit for Laravel — flag class generator, Eloquent integration, fluent query scopes and bit-level helpers.",
  "type"              : "library",
  "license"           : "MIT",
  "keywords"          : [
    "laravel",
    "bitmask",
    "bitwise",
    "flags",
    "eloquent"
  ],
  "authors"           : [
    {
      "name"  : "Zuko",
      "email" : "tansautn@gmail.com"
    }
  ],
  "require"           : {
    "php"                  : "^8.2",
    "illuminate/console"   : "^11.0|^12.0|^13.0",
    "illuminate/contracts" : "^11.0|^12.0|^13.0",
    "illuminate/database"  : "^11.0|^12.0|^13.0",
    "illuminate/support"   : "^11.0|^12.0|^13.0"
  },
  "require-dev"       : {
    "phpunit/phpunit" : "^11.5|^12.0|^13.0"
  },
  "autoload"          : {
    "psr-4" : {
      "Zuko\\BitMasks\\" : "src/"
    },
    "files" : [
      "src/helpers.php"
    ]
  },
  "autoload-dev"      : {
    "psr-4" : {
      "Zuko\\BitMasks\\Tests\\" : "tests/"
    }
  },
  "extra"             : {
    "laravel" : {
      "providers" : [
        "Zuko\\BitMasks\\BitMasksServiceProvider"
      ]
    }
  },
  "scripts"           : {
    "test" : "phpunit"
  },
  "minimum-stability" : "stable",
  "prefer-stable"     : true
}
